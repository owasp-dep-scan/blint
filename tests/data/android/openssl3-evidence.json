{
 "description": "OpenSSL 3 vs BoringSSL namespace evidence (A6.3 J2). OpenSSL 3's public OSSL_* API is exported by its shared libcrypto/libssl and imported by callers; its internal ossl_* namespace is exported only by a static copy linked without OpenSSL's version script (librealm-jni.so, element 1.6.62, statically links realm-core 13.26.0's vcpkg arm64-android OpenSSL 3). No tier-0 BoringSSL libcrypto.so/libssl.so defines or imports either.",
 "extracting_commands": {
  "realm_ossl_exports": "llvm-nm -D --defined-only lib/arm64-v8a/librealm-jni.so (im.vector.app_40106622.apk) | grep '^ossl_'",
  "boringssl_libcrypto_exports": "llvm-nm -D --defined-only libcrypto.so (api36-arm64 system image)",
  "openssl3_shared_libssl": "llvm-nm -D --defined-only / --undefined-only libssl.so (vcpkg openssl 3.6.2, arm64-android-dynamic, blint-db feat/an-a6-2 I2) | grep -E '^(OSSL|ossl)_'",
  "openssl3_shared_libcrypto": "llvm-nm -D --defined-only libcrypto.so (same build)",
  "boringssl_tier0": "llvm-nm -D on every libcrypto.so/libssl.so (and *_libcrypto.so/*_libssl.so) under the api34/api35/api36 system images, 78 files | grep -E '^(OSSL|ossl)_'"
 },
